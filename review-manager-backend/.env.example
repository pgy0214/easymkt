# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Aligo (알리고) SMS API — used to send portal login OTP codes, and (once set)
# the "선택 메시지 발송" bulk-SMS feature in 리뷰어 관리
ALIGO_USER_ID=
ALIGO_API_KEY=
ALIGO_SENDER=

# Aligo 카카오 알림톡 발신프로필키 — 위 SMS 자격증명에 추가로 필요. 카카오 비즈니스
# 채널을 알리고에 연동하고 템플릿을 사전 승인받아야 사용 가능(별도 절차, 코드로는 안 됨).
# 알림톡은 승인된 템플릿 문구와 정확히 일치해야 발송되므로 자유 텍스트는 불가.
ALIGO_KAKAO_SENDER_KEY=

# Random long string used to sign self-service portal login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
PORTAL_JWT_SECRET=

# Encryption key for admin account passwords stored in the DB (관리자 계정의
# 계정비밀번호 필드) — MUST be the same value on every computer that shares
# review_manager.db, or passwords encrypted on one machine can't be read back
# on another. Generate one with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ACCOUNT_SECRET_KEY=

# Set to false to watch Chrome pop up and click through pages live while
# debugging the crawlers (Naver date/blind-check, Kakao blind-check).
# Leave unset or "true" for normal background (headless) operation.
CRAWLER_HEADLESS=true

# AdsPower antidetect-browser Local API — used to launch a 관리자계정's assigned
# browser profile (its own fingerprint + proxy IP + persistent Naver login) with
# one click. Requires the AdsPower desktop app running on THIS machine and a paid
# AdsPower plan (Local API access is gated on paid plans). Get the API key from
# AdsPower 설정 > API & MCP > API Key (Generate).
ADSPOWER_BASE_URL=http://local.adspower.net:50325
ADSPOWER_API_KEY=

# Anthropic API — 캠페인 원고 업로드분이 작업 갯수보다 적을 때, 부족한 만큼 원고
# 가이드라인/지역적 특징을 바탕으로 리뷰 원고를 자동 생성하는 데 사용.
# https://console.anthropic.com 에서 발급.
ANTHROPIC_API_KEY=

# 관리자 대시보드 로그인 — 관리자가 1명뿐이라 DB 테이블 대신 .env로 관리.
# ADMIN_USERNAME은 아래 기본값 그대로 써도 됨. ADMIN_PASSWORD_HASH 생성:
# python -c "import bcrypt; print(bcrypt.hashpw(b'YOUR_PASSWORD', bcrypt.gensalt()).decode())"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# 관리자 로그인 토큰 서명용 — PORTAL_JWT_SECRET과 반드시 분리(리뷰어 토큰이
# 관리자 토큰으로 재사용되는 것 방지). 생성: python -c "import secrets; print(secrets.token_hex(32))"
ADMIN_JWT_SECRET=

# 카카오 로그인(리뷰어 포털 전용 추가 로그인 수단) — developers.kakao.com에서
# 앱 생성 후 발급. REST API 키는 client_id로 프론트에도 노출되는 값이라 정상,
# Client Secret은 백엔드에서만 사용.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오 개발자 콘솔에 등록한 Redirect URI와 정확히 일치해야 함. 별도 콜백
# 라우트 없이 /portal 페이지가 ?code= 쿼리파라미터를 직접 감지해서 처리.
KAKAO_REDIRECT_URI=http://localhost:5173/portal

# 개발 단계 전용 — 값을 채우면 /portal 접속 시 전화번호 OTP 로그인 화면을 건너뛰고
# 여기 적은 리뷰어 id로 자동 로그인된다(로그인 화면 없이 바로 다음 화면 확인용).
# 반드시 로컬 개발에서만 쓰고, 배포/공유 환경에서는 비워둘 것 — 켜져 있으면 누구나
# 이 서버에 접속해서 인증 없이 해당 리뷰어로 로그인할 수 있음.
PORTAL_DEV_BYPASS_REVIEWER_ID=
