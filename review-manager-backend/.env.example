# Copy this file to .env and fill in real values. .env is gitignored — never commit real secrets.

# Aligo (알리고) SMS API — used to send portal login OTP codes
ALIGO_USER_ID=
ALIGO_API_KEY=
ALIGO_SENDER=

# Random long string used to sign self-service portal login tokens.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
PORTAL_JWT_SECRET=

# Set to false to watch Chrome pop up and click through pages live while
# debugging the crawlers (Naver date/blind-check, Kakao blind-check).
# Leave unset or "true" for normal background (headless) operation.
CRAWLER_HEADLESS=true
